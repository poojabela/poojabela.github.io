---
const { name, class: className = "", strokeWidth = 2.5, ...rest } = Astro.props;

const strokes = {
  star: "M12 2.5l2.6 6.6 7 .5-5.4 4.5 1.8 6.9L12 17.3 6 21l1.8-6.9-5.4-4.5 7-.5z",
  squiggle: "M2 14c3-8 6-8 8 0s5 8 8 0 5-8 8 0 5 8 8 0",
  arrow: "M3 20c6-12 16-15 27-11M24 4l6 5-7 4",
  x: "M5 5l14 14M19 5L5 19",
  heart: "M12 20s-8-5-8-11a4.5 4.5 0 0 1 8-2.8A4.5 4.5 0 0 1 20 9c0 6-8 11-8 11z",
  book: "M2 6c4-2 7-2 10 1 3-3 6-3 10-1v13c-4-2-7-2-10 1-3-3-6-3-10-1zM12 7v13",
  laptop: "M5 5h14v10H5zM2 19h20l-2.5-4h-15z",
  sparkle: "M12 3v5M12 16v5M3 12h5M16 12h5M6 6l2.5 2.5M15.5 15.5L18 18M18 6l-2.5 2.5M8.5 15.5L6 18",
  envelope: "M3 6h18v12H3zM3 6.5l9 7 9-7",
  sun: "M12 8a4 4 0 1 1 0 8 4 4 0 0 1 0-8zM12 2v3M12 19v3M2 12h3M19 12h3M5 5l2 2M17 17l2 2M19 5l-2 2M7 17l-2 2",
  moon: "M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z",
  circle: "M12 3c5 0 9 3.5 9 8.5S17 21 11.5 21 3 17 3 12.2C3 7 7 3.2 12.5 3.4",
  plant: "M7 14h10l-1.5 7h-7zM12 14V7M12 11c-3-.5-5-2.5-5-5.5 3 0 5 2 5 5.5zM12 9c1.5-2.5 4-3.5 6.5-3-.5 3-3 4.5-6.5 3z",
};
const viewBoxes = { squiggle: "0 0 36 24", arrow: "0 0 34 24" };
---

{name === "blob" ? (
  <svg viewBox="0 0 24 24" class:list={["doodle", className]} aria-hidden="true">
    <path fill="currentColor" d="M12 2.5c5.5-.3 9.4 3.6 9 9.3-.4 5.6-4.6 10-10 9.7C5.6 21.2 2.4 17 2.6 12 2.8 6.6 6.6 2.8 12 2.5z" />
  </svg>
) : (
  <svg
    viewBox={viewBoxes[name] ?? "0 0 24 24"}
    class:list={["doodle", className]}
    fill="none"
    stroke="currentColor"
    stroke-width={strokeWidth}
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    {...rest}
  >
    <path d={strokes[name]} pathLength="1" />
  </svg>
)}
