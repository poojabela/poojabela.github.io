---
const windows = [
  { title: "Window 1", page: "index.html", color: "bg-note-yellow", tilt: "-rotate-1" },
  { title: "Window 2", page: "settings.html", color: "bg-note-blue", tilt: "rotate-1" },
];
const powers = ["Node.js", "files", "windows", "menus", "dialogs"];
---

<figure class="not-prose my-10">
  <div class="mx-auto max-w-md rounded-md border-2 border-ink bg-card p-4 shadow-[4px_4px_0_var(--ink)]">
    <p class="font-hand text-3xl leading-none font-bold">main process</p>
    <p class="mt-1 text-xs text-pencil">one per app, starts first</p>
    <div class="mt-3 flex flex-wrap gap-1.5">
      {powers.map((power) => (
        <span class="rounded-full border border-ink px-2 text-xs">{power}</span>
      ))}
    </div>
  </div>

  <div class="mx-auto flex max-w-md justify-around" aria-hidden="true">
    {windows.map(() => (
      <div class="flex flex-col items-center">
        <span class="h-10 border-l-2 border-dashed border-pencil" />
        <span class="-my-1 font-hand text-lg text-pencil">IPC</span>
        <span class="h-6 border-l-2 border-dashed border-pencil" />
      </div>
    ))}
  </div>

  <div class="grid gap-6 sm:grid-cols-2">
    {windows.map((win) => (
      <div class:list={["sticky-note overflow-hidden rounded-sm", win.color, win.tilt]}>
        <div class="flex items-center gap-1.5 border-b border-note-ink/20 px-3 py-2">
          <span class="h-2.5 w-2.5 rounded-full bg-[#e5484d]" />
          <span class="h-2.5 w-2.5 rounded-full bg-[#f2b705]" />
          <span class="h-2.5 w-2.5 rounded-full bg-[#2e9e5b]" />
          <span class="ml-2 text-xs">{win.title}</span>
        </div>
        <div class="border-b-2 border-dashed border-note-ink/30 px-3 py-2">
          <p class="font-hand text-xl leading-none font-bold">preload.js</p>
          <p class="mt-1 text-xs opacity-70">runs first, exposes a small API</p>
        </div>
        <div class="px-3 py-3">
          <p class="font-hand text-xl leading-none font-bold">renderer</p>
          <p class="mt-1 text-xs opacity-70">{win.page}, HTML, CSS, your UI</p>
        </div>
      </div>
    ))}
  </div>
  <figcaption class="mt-6 text-center font-hand text-xl text-pencil">
    one main process controls all the windows, and each window has its own renderer
  </figcaption>
</figure>
